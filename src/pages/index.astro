---
import { Icon } from "@astrojs/starlight/components";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const title = "Moons — full-stack TypeScript that can’t leak server code";
const description =
  "Moon is a file-based full-stack framework for React: SSR, loaders, server functions and raw API routes, with a build-time boundary that makes server-code leaks impossible.";

const install = "bunx --package @moonsjs/cli moons create my-app";

const features = [
  {
    icon: "document" as const,
    title: "File-based routing",
    body: "Pages, layouts, `_404` and `_error` files under `src/routes`. Typegen keeps `<Link>` hrefs and search params honest.",
  },
  {
    icon: "approve-check" as const,
    title: "serverFn, validated on both sides",
    body: "Declare input and output once — zod or any Standard Schema. The client gets a typed RPC stub; the server keeps the handler.",
  },
  {
    icon: "code" as const,
    title: "Zero-trust build",
    body: "Every `*.server.ts` becomes an RPC stub in the client bundle. Importing server code from a route fails the build with `E_SERVER_IMPORT_IN_CLIENT`.",
  },
  {
    icon: "rocket" as const,
    title: "SSR today, hydration that stays in sync",
    body: "Routes render on the server and hydrate on the client, with loaders and `useSearchParams` sharing the same values.",
  },
  {
    icon: "laptop" as const,
    title: "API routes, prerender & ISR",
    body: "`src/api/*.ts` gives you raw HTTP endpoints. Prerender still pages and revalidate them with on-demand ISR.",
  },
  {
    icon: "moon" as const,
    title: "Built for AI agents",
    body: "`llms.txt`, `/raw` markdown, an MCP server, and `moons routes|fns|check --json` for machine-readable introspection.",
  },
];

const layers = [
  {
    title: "Build",
    body: "A Vite transform replaces every `*.server.ts` with an RPC stub before the client bundle is written. The original source never ships.",
  },
  {
    title: "Runtime",
    body: "Server functions run in-process during SSR; on the client they POST to hashed endpoints with an `x-moons` header. No eval, no serialized source.",
  },
  {
    title: "Guards",
    body: "Leak tests grep `dist/client` for handler bodies, env values and canary strings. A leak fails CI — not production.",
  },
];

const stack = ["React 19", "Vite", "Tailwind v4", "Drizzle ORM", "bun:sqlite", "Node & Bun"];
---

<StarlightPage frontmatter={{ title, description, template: "splash" }}>
  <div class="moons-landing">
    <section class="hero">
      <div class="hero-copy">
        <span class="pill">Zero-trust by construction</span>
        <h1>Full-stack TypeScript that can’t leak server code.</h1>
        <p class="lead">
          Moons is a file-based framework for React — SSR, loaders, server functions and raw
          API routes — with a build-time boundary that turns “never import server code” into
          “the build refuses”.
        </p>

        <div class="install" role="group" aria-label="Install command">
          <code>{install}</code>
          <button type="button" data-copy={install} aria-label="Copy install command">Copy</button>
        </div>

        <div class="cta">
          <a class="button primary" href="/start/quickstart/">
            Get started <Icon name="arrow-right" />
          </a>
          <a class="button" href="https://github.com/moonsjs/cookbook">
            <Icon name="github" /> Cookbook
          </a>
        </div>

        <ul class="chips" aria-label="At a glance">
          <li>MIT license</li>
          <li>TypeScript strict</li>
          <li>Runs on Bun &amp; Node</li>
        </ul>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <figure class="codecard server">
          <figcaption>
            <span class="dot" /><span class="dot" /><span class="dot" />
            <span class="file">src/server/moons.server.ts</span>
          </figcaption>
          <pre><code><span class="c">// runs on the server — never shipped</span>
<span class="k">import</span> &#123; serverFn &#125; <span class="k">from</span> <span class="s">"@moonsjs/server"</span>;

<span class="k">export const</span> <span class="f">moonById</span> = <span class="f">serverFn</span>(&#123;
  input: z.<span class="f">object</span>(&#123; id: z.<span class="f">string</span>() &#125;),
  handler: <span class="k">async</span> (&#123; input &#125;) =&gt; db.moons.<span class="f">find</span>(input.id),
&#125;);</code></pre>
        </figure>

        <figure class="codecard leak">
          <figcaption>
            <span class="dot" /><span class="dot" /><span class="dot" />
            <span class="file">src/routes/moon.tsx</span>
          </figcaption>
          <pre><code><span class="k">import</span> &#123; moonById &#125; <span class="k">from</span> <span class="s">"../server/moons.server"</span>;</code></pre>
          <div class="leaknote">
            <code>E_SERVER_IMPORT_IN_CLIENT</code>
            <span>Client code importing <code>*.server.ts</code> fails the build — by design.</span>
          </div>
        </figure>
      </div>
    </section>

    <section class="features">
      <h2>Everything you need, nothing that leaks</h2>
      <div class="grid">
        {features.map((feature) => (
          <article>
            <span class="icon"><Icon name={feature.icon} /></span>
            <h3>{feature.title}</h3>
            <p set:html={feature.body.replace(/`([^`]+)`/g, "<code>$1</code>")} />
          </article>
        ))}
      </div>
    </section>

    <section class="layers">
      <h2>Zero-trust, in three layers</h2>
      <div class="grid three">
        {layers.map((layer, index) => (
          <article>
            <span class="step">0{index + 1}</span>
            <h3>{layer.title}</h3>
            <p set:html={layer.body.replace(/`([^`]+)`/g, "<code>$1</code>")} />
          </article>
        ))}
      </div>
    </section>

    <section class="agents">
      <div class="agents-copy">
        <h2>Machine-readable by default</h2>
        <p>
          Moons ships its own context: a compact agent guide, recipes that link real cookbook
          source, and an MCP server over stdio with <code>list_routes</code>,
          <code>get_fn_registry</code>, <code>run_check</code> and <code>search_docs</code>.
        </p>
        <p class="agent-links">
          <a href="/ai/context/">Agent context</a>
          <a href="/ai/recipes/search-params/">Recipes</a>
          <a href="/api/mcp/">MCP reference</a>
        </p>
      </div>
      <figure class="codecard terminal" aria-hidden="true">
        <figcaption>
          <span class="dot" /><span class="dot" /><span class="dot" />
          <span class="file">terminal</span>
        </figcaption>
        <pre><code><span class="p">$</span> bunx --package @moonsjs/mcp moons-mcp
<span class="c"># stdio: list_routes · get_fn_registry · run_check · search_docs</span>

<span class="p">$</span> moons check --json
&#123; <span class="s">"ok"</span>: <span class="k">true</span>, <span class="s">"steps"</span>: [ … ] &#125;</code></pre>
      </figure>
    </section>

    <section class="stack" aria-label="Works with">
      <span>Plays well with</span>
      <ul>
        {stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>

    <section class="final-cta">
      <h2>Ship your first zero-trust route</h2>
      <p>One command to scaffold, one build to prove nothing leaks.</p>
      <div class="cta">
        <a class="button primary" href="/start/quickstart/">
          Read the quickstart <Icon name="arrow-right" />
        </a>
        <a class="button" href="https://github.com/moonsjs">
          <Icon name="github" /> Star on GitHub
        </a>
      </div>
    </section>
  </div>

  <script is:inline>
    document.querySelectorAll("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.getAttribute("data-copy"));
          const previous = button.textContent;
          button.textContent = "Copied!";
          setTimeout(() => {
            button.textContent = previous;
          }, 1400);
        } catch {}
      });
    });
  </script>
</StarlightPage>

<style>
  .moons-landing {
    padding-block: 3rem 4rem;
  }

  .moons-landing h1 {
    font-size: clamp(2rem, 4.4vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0.6rem 0 1rem;
    background: var(--moons-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .moons-landing h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    margin-bottom: 5rem;
  }

  .pill {
    display: inline-block;
    font-size: var(--sl-text-xs);
    font-weight: 560;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
  }

  .lead {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
    max-width: 34rem;
  }

  .install {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.75rem 0;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--moons-radius);
    background: var(--moons-code-bg);
    font-size: var(--sl-text-sm);
    max-width: 34rem;
  }

  .install code {
    flex: 1;
    font-family: var(--sl-font-mono);
    overflow-x: auto;
    white-space: nowrap;
  }

  .install button {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 9px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 560;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
  }

  .install button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 11px;
    padding: 0.6rem 1.05rem;
    font-weight: 560;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text);
    text-decoration: none;
    background: var(--sl-color-bg);
    transition: border-color 140ms ease, transform 140ms ease;
  }

  .button:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: white;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .chips li::before {
    content: "◆";
    font-size: 0.6em;
    color: var(--sl-color-accent);
    margin-inline-end: 0.45rem;
    vertical-align: 0.15em;
  }

  /* --- code cards --- */
  .hero-visual {
    display: grid;
    gap: 1.1rem;
  }

  .codecard {
    margin: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--moons-radius-lg);
    background: var(--sl-color-bg);
    overflow: hidden;
    box-shadow: 0 14px 32px -22px rgba(24, 20, 70, 0.45);
  }

  .codecard figcaption {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-hairline-light);
  }

  .codecard .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sl-color-hairline-shade);
  }

  .codecard .file {
    margin-inline-start: 0.6rem;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .codecard pre {
    margin: 0;
    padding: 1rem 1.1rem;
    background: var(--moons-code-bg);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.7;
    overflow-x: auto;
  }

  .codecard .k { color: #7c5cff; }
  .codecard .s { color: #0f9b8e; }
  .codecard .f { color: #2f6fed; }
  .codecard .c { color: var(--sl-color-gray-3); }
  .codecard .p { color: var(--sl-color-accent-high); }

  :global(:root[data-theme="dark"]) .codecard .k { color: #b3a4ff; }
  :global(:root[data-theme="dark"]) .codecard .s { color: #7fe0d0; }
  :global(:root[data-theme="dark"]) .codecard .f { color: #8fb8ff; }

  .leaknote {
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 1.1rem;
    background: color-mix(in srgb, #e5484d 10%, transparent);
    border-top: 1px dashed color-mix(in srgb, #e5484d 45%, transparent);
    font-size: var(--sl-text-xs);
  }

  .leaknote > code {
    color: #e5484d;
    font-weight: 600;
    font-family: var(--sl-font-mono);
  }

  .leaknote span {
    color: var(--sl-color-gray-2);
  }

  /* --- features --- */
  .features,
  .layers,
  .agents,
  .final-cta {
    margin-bottom: 5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.1rem;
  }

  .grid article {
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--moons-radius-lg);
    padding: 1.3rem;
    background: var(--sl-color-bg);
    transition: border-color 140ms ease, transform 140ms ease;
  }

  .grid article:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-hairline));
    transform: translateY(-2px);
  }

  .grid h3 {
    font-size: var(--sl-text-base);
    margin: 0.85rem 0 0.4rem;
    letter-spacing: -0.01em;
  }

  .grid p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 10px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .step {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent);
    letter-spacing: 0.08em;
  }

  /* --- agents --- */
  .agents {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 3rem;
    align-items: center;
  }

  .agents-copy p {
    color: var(--sl-color-gray-2);
  }

  .agent-links {
    display: flex;
    gap: 1.25rem;
    font-size: var(--sl-text-sm);
  }

  /* --- stack --- */
  .stack {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-bottom: 5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stack li {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    padding: 0.28rem 0.8rem;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-bg);
  }

  /* --- final cta --- */
  .final-cta {
    border: 1px solid var(--sl-color-hairline);
    border-radius: calc(var(--moons-radius-lg) + 4px);
    padding: 2.5rem;
    text-align: center;
    background:
      radial-gradient(60% 120% at 50% 0%, color-mix(in srgb, var(--sl-color-accent) 12%, transparent), transparent),
      var(--sl-color-bg);
  }

  .final-cta p {
    color: var(--sl-color-gray-2);
    margin-top: 0;
  }

  .final-cta .cta {
    justify-content: center;
  }

  @media (max-width: 60rem) {
    .hero,
    .agents {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero {
      margin-bottom: 3.5rem;
    }
  }
</style>
