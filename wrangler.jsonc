// Static deploy (Cloudflare Workers static assets). The build emits
// `dist/client` (static export, including 404.html) and `dist/server`
// (used by `moons start`).
{
  "name": "docs",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  }
}
