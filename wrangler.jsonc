// Deploy statis (Cloudflare Workers static assets). Tanpa ini, `wrangler deploy`
// menjalankan auto-config yang mengubah proyek menjadi Workers+adapter Astro.
{
  "name": "docs",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
